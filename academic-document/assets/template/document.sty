\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{document}[2026/10/16 v1.0.0 Minimalist research document template]

% ---- Text, mathematics, and code fonts ----

\RequirePackage{iftex}
\RequirePackage{amsmath,amssymb,amsthm}
\ifPDFTeX
  \RequirePackage[utf8]{inputenc}
  \RequirePackage[T1]{fontenc}
  \RequirePackage{libertinus-type1}
  \RequirePackage[upint]{libertinust1math}
  \RequirePackage[scale=0.9]{cascadia-code}
  \RequirePackage[cal=stixplain,scr=boondox,frak=euler]{mathalfa}
  \newcommand{\hmmax}{0}
  \newcommand{\bmmax}{0}
  \RequirePackage{bm}
  \renewcommand{\mathbcal}[1]{\mathbfcal{#1}}
  \newcommand{\mathbscr}[1]{\mathbfscr{#1}}
  \newcommand{\mathbfrak}[1]{\mathbffrak{#1}}
\else
  \RequirePackage{unicode-math}
  \RequirePackage{libertinus-otf}
  \setmathfont{XITSMath-Regular}[
    StylisticSet=1,range={cal,bfcal},
    Extension=.otf,BoldFont=XITSMath-Bold]
  \let\mathbfscr\relax
  \let\mathbffrak\relax
  \RequirePackage[scr=boondox,frak=euler]{mathalfa}
  \setmonofont{CascadiaCode}[
    Scale=0.9,RawFeature={-calt,-liga,-clig},
    Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic,
    BoldFont=*-Bold,BoldItalicFont=*-BoldItalic]
  \let\bm\symbf
  \newcommand{\mathbcal}[1]{\symbfcal{#1}}
  \newcommand{\mathbscr}[1]{\mathbfscr{#1}}
  \newcommand{\mathbfrak}[1]{\symbffrak{#1}}
\fi
% Keep the article serif on every engine; Beamer's sans default is not inherited.
\renewcommand{\familydefault}{\rmdefault}

\RequirePackage{microtype}
\ifPDFTeX
  % Preserve literal code punctuation, including --, <<, and >>.
  \AddToHook{selectfont}{%
    \ifnum\pdfstrcmp{\f@family}{\ttdefault}=0\relax
      \pdfnoligatures\font
    \fi}
\fi

% ---- Page layout and the Beamer template's light palette ----

\RequirePackage[margin=1in]{geometry}
\RequirePackage[onehalfspacing]{setspace}
\RequirePackage{xcolor}
\definecolor{GitHubFg}{HTML}{1F2328}
\definecolor{GitHubMuted}{HTML}{656D76}
\definecolor{GitHubCanvas}{HTML}{FFFFFF}
\definecolor{GitHubCanvasSubtle}{HTML}{F6F8FA}
\definecolor{GitHubBorder}{HTML}{D0D7DE}
\definecolor{GitHubBlue}{HTML}{0969DA}
\definecolor{GitHubRed}{HTML}{CF222E}
\definecolor{GitHubGreen}{HTML}{1A7F37}
\definecolor{GitHubYellow}{HTML}{9A6700}
\definecolor{GitHubPurple}{HTML}{8250DF}
\definecolor{GitHubCodeComment}{HTML}{6E7781}
\definecolor{GitHubCodeKeyword}{HTML}{CF222E}
\definecolor{GitHubCodeString}{HTML}{0A3069}
\AtBeginDocument{\color{GitHubFg}}
\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{1em}
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\pagestyle{plain}
\raggedbottom

% ---- Title, abstract, and section headings ----

\RequirePackage{etoolbox}
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\Large\bfseries\raggedright}{\thesection}{0.75em}{}
\titleformat{\subsection}{\normalfont\large\bfseries\raggedright}{\thesubsection}{0.75em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries\raggedright}{\thesubsubsection}{0.75em}{}
\titlespacing*{\section}{0pt}{2ex plus 1ex minus .2ex}{0.8ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.5ex plus .5ex minus .2ex}{0.5ex plus .2ex}
\titlespacing*{\subsubsection}{0pt}{1ex plus .5ex minus .2ex}{0.5ex plus .2ex}

% Retain article's public \maketitle so \thanks and \and still work.
\renewcommand{\@maketitle}{%
  \newpage
  \null
  \begingroup
    \singlespacing
    \raggedright
    \let\footnote\thanks
    {\normalfont\LARGE\bfseries\@title\par}%
    \vspace{0.6em}%
    {\color{GitHubFg}\hrule height 1pt}%
    \vspace{1.2em}%
    {\normalsize\begin{tabular}[t]{@{}l@{}}\@author\end{tabular}\par}%
    \ifx\@date\@empty\else
      \vspace{0.7em}%
      {\small\color{GitHubMuted}\@date\par}%
    \fi
  \endgroup
  \vspace{1.5em}}
\renewenvironment{abstract}{%
  \begin{quote}\small\singlespacing
  \noindent\textbf{\abstractname}\par\smallskip\noindent\ignorespaces
}{\par\end{quote}}
\newcommand{\keywords}[1]{%
  \par\smallskip{\small\singlespacing\noindent\textit{Keywords:} #1\par}}

% ---- Lists and mathematical statements ----

\RequirePackage{enumitem}
\setlist{topsep=0.5\baselineskip,itemsep=0.15\baselineskip,parsep=0pt}
\setlist[itemize,1]{label={\color{GitHubMuted}\(\square\)}}
\setlist[itemize,2]{label={\color{GitHubMuted}\(\triangleright\)}}
\setlist[itemize,3]{label={\color{GitHubMuted}\textendash}}
\setlist[enumerate,1]{label=\arabic*.,ref=\arabic*}
\setlist[enumerate,2]{label=\alph*.,ref=\theenumi\alph*}
\numberwithin{equation}{section}
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{assumption}[theorem]{Assumption}
\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}
\newtheorem{example}[theorem]{Example}

% ---- Figures, tables, and captions ----

\RequirePackage[export]{adjustbox}
\RequirePackage{booktabs,multirow,longtable,tabularx}
\RequirePackage{caption}
\captionsetup{font={small,stretch=1},labelfont=bf,labelsep=period}
\captionsetup[table]{position=top}
\AtBeginEnvironment{figure}{\singlespacing}
\AtBeginEnvironment{table}{\singlespacing}
\AtBeginEnvironment{longtable}{\singlespacing}
\newcommand{\figurenote}[1]{%
  \par\smallskip{\footnotesize\singlespacing\color{GitHubMuted}\noindent #1\par}}

% ---- Code and algorithms ----

\RequirePackage{listings}
\lstdefinestyle{minimalcode}{
  basicstyle=\ttfamily\small\singlespacing,
  backgroundcolor=\color{GitHubCanvasSubtle},
  keywordstyle=\color{GitHubCodeKeyword},
  commentstyle=\color{GitHubCodeComment},
  stringstyle=\color{GitHubCodeString},
  numbers=left,
  numberstyle=\tiny\color{GitHubMuted},
  numbersep=0.75em,
  xleftmargin=2em,
  frame=none,
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true,
  tabsize=2,
  breaklines=true,
  captionpos=b
}
\lstset{style=minimalcode}
\RequirePackage{algorithm,algpseudocode}
\AtBeginEnvironment{algorithm}{\singlespacing}

% ---- Bibliography and cross-references ----

\RequirePackage[backend=biber,authordate,sorting=nyt,ibidtracker=false,
  giveninits=true,uniquename=mininit,
  isbn=false,url=false,doi=false,eprint=false]{biblatex-chicago}
\AtBeginBibliography{\small\singlespacing}
\setlength{\bibitemsep}{0.5\baselineskip}
\RequirePackage{xurl}
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=GitHubBlue,
  citecolor=GitHubBlue,
  urlcolor=GitHubBlue,
  pdfpagemode=UseNone,
  pdfdisplaydoctitle=true
}
\RequirePackage{bookmark}
\urlstyle{tt}
